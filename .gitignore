# Lourd / régénérable : ne jamais committer
/models/
*.gguf
*.safetensors
*.bin
*.onnx
tools/
.venv/
.venv-target/
build*/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# Divers
compile_commands.json
.cache/
*.log

# Données (régénérables via téléchargement Kaggle) ; seule la liste des sources est versionnée
data/*
!data/SOURCES.md

# Sorties de démo et rapports générés (régénérables)
out/

# Fichiers temporaires / caches / secrets
*.part
*.parquet
*.npy
*.npz
.env
kaggle.json

# Exception : le modèle livré (petit) est versionné
!arbre/artifacts/*.onnx

# Modèles livrés : les fichiers d'inférence de strict (temps réel), typology et j1 (revue J+1 de la démo) sont versionnés,
# lgbm.txt compris (TreeSHAP, régénérable par `python -m aml export-lgbm`) ; les variantes d'expérience restent locales
arbre/artifacts/models/*
!arbre/artifacts/models/strict/
!arbre/artifacts/models/typology/
!arbre/artifacts/models/j1/

# Configuration locale (propre à chaque poste)
.vscode/
env.sh
